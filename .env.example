APP_NAME=safalife-api
APP_ENV=local
APP_PORT=8080

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=safalife_db
DB_HOST_PORT=9543

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_HOST_PORT=6379

# Monitoring
JAEGER_ENDPOINT=localhost:4318
JAEGER_SERVICE_NAME=safalife-api

# JWT
JWT_SECRET=your-secret-key-change-this
JWT_ACCESS_TOKEN_TTL=60
JWT_REFRESH_TOKEN_TTL=10080
JWT_ISSUER=safalife-api

# Storage
S3_ENABLED=false
S3_BUCKET=your-local-bucket
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# Auth Integration
AUTH_BASE_URL=http://safalife-auth-api:9001
AUTH_VERIFY_PATH=/auth/v1/jwt/jwks
AUTH_TIMEOUT_SECONDS=3

# Prayer Times
PRAYERTIMES_ALADHAN_BASE_URL=https://api.aladhan.com/v1
PRAYERTIMES_TIMEOUT_SECONDS=15